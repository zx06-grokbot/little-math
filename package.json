{
	"name": "little-math",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.0.7",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-vercel": "^6.3.2",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^22.20.5",
		"svelte": "^5.55.7",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@vercel/analytics": "^1.6.1",
		"@vercel/speed-insights": "^1.3.1",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1"
	},
	"engines": {
		"node": "22.x"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.0",
			"tar": "^7.5.4"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"core-js"
		]
	}
}
